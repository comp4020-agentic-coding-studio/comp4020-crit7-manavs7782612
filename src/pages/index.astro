---
import { listPermitTypes } from "../lib/db";
import "../styles.css";

const permitTypes = listPermitTypes();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>ANU ePermit — parking permits</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Permits</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Parking permits</h1>
      <p>
        Choose the permit that matches who you are. Each one shows its eligibility criteria and required
        documents before you apply.
      </p>
      <ul class="permit-list">
        {
          permitTypes.map((permitType) => (
            <li class="permit-card">
              <span class={`tag tag-${permitType.audience}`}>{permitType.audience}</span>
              <h2>
                <a href={`/permits/${permitType.slug}`}>{permitType.name}</a>
              </h2>
              <p>{permitType.description}</p>
              <p class="price">
                {permitType.priceCents === 0
                  ? "Free"
                  : `$${(permitType.priceCents / 100).toFixed(2)}`}
              </p>
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
